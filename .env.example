# Copy this file to .env and fill in real values. Never commit .env itself.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Storage (all paths are project-relative; nothing is written outside ./data) ---
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
CHROMA_DIR=./data/chroma
SQLITE_PATH=./data/sqlite/app.db
CLASSIFIER_MODEL_DIR=./data/classifier/model

# --- LLM provider selection ---
# Which provider generates answers. Embeddings ALWAYS use Ollama regardless of this setting.
GENERATION_PROVIDER=groq
# If the active generation provider errors (e.g. Groq 429/5xx), retry once via local Ollama.
FALLBACK_TO_LOCAL_ON_ERROR=true

# --- Ollama (project-scoped local install, see scripts/setup_ollama.sh) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# llama3.1:8b is used (not the smaller 3b) because it follows the strict JSON citation
# schema far more reliably in testing — swap to llama3.2:3b for faster/lighter inference
# on constrained hardware if you accept looser schema compliance (see README limitations).
OLLAMA_GENERATION_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Groq (free tier: https://console.groq.com) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# --- Guardrails thresholds ---
RAG_TOP_K=8
RAG_RELEVANCE_FLOOR=0.15
RAG_MIN_SIMILARITY=0.35
RAG_VERIFY_THRESHOLD=0.25
RAG_MAX_HOPS=2
RAG_MAX_HOP_CHUNKS=12

# --- Chunking ---
CHUNK_TARGET_CHARS=2000
CHUNK_OVERLAP_CHARS=300
